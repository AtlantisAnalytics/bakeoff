// Cloudflare Worker "bakeoff": static assets only (no script), served at bakeoff.si.
// Deployed by Cloudflare Workers Builds from this repo (connect it under the Worker's Settings -> Build).
// The custom domains are declared here so a Git deploy keeps them; workers.dev and preview URLs stay off
// (they would expose the account subdomain).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakeoff",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "bakeoff.si", "custom_domain": true },
    { "pattern": "www.bakeoff.si", "custom_domain": true }
  ]
}
